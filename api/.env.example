# =============================================================================
# Church Register — API Laravel : modèle de configuration
# -----------------------------------------------------------------------------
# Copier en .env puis `php artisan key:generate`. Ne JAMAIS commiter le .env.
# Aucune valeur réelle ici : les secrets de production sont saisis une seule
# fois en SSH dans ~/church-register/shared/.env.
# Les valeurs indiquées sont celles du développement local ; les réglages de
# production sont rappelés en commentaire (« Prod : … »).
# =============================================================================

APP_NAME="Church Register"
# Prod : production
APP_ENV=local
# Clé de chiffrement (sessions, cookies, 2FA, jetons de parcours) : distincte par environnement.
APP_KEY=
# Prod : false (obligatoire). Même à true, l'API ne renvoie jamais de détail technique hors « local ».
APP_DEBUG=true
# URL publique du SPA. Dev : Vite (proxy /api et /sanctum vers 127.0.0.1:8000).
# Prod : https://registre.exemple.org (liens des e-mails, domaine « stateful » par défaut).
APP_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
# « Aujourd'hui » (date de visite, rotation mensuelle, tâches planifiées) est calculé dans ce fuseau.
APP_TIMEZONE=Africa/Abidjan

APP_MAINTENANCE_DRIVER=file

# Hachage des mots de passe : argon2id (config/hashing.php). Coûts par défaut : 64 Mo, 4 itérations.
# ARGON_MEMORY=65536
# ARGON_TIME=4
# ARGON_THREADS=1

LOG_CHANNEL=stack
# Prod : daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Prod : warning
LOG_LEVEL=debug

# --- Base de données (MariaDB) -----------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
# Dev (WampServer) : 3307. Prod (Hostinger) : 3306.
DB_PORT=3307
DB_DATABASE=church_register
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions (dashboard admin, Sanctum SPA) ---------------------------------
SESSION_DRIVER=database
# Expiration après 120 minutes d'inactivité.
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
# Contenu des sessions chiffré en base (APP_KEY) : un accès en lecture seule à la table
# `sessions` ne révèle plus l'identité ni les données de session des administrateurs.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie « Secure » (envoyé en HTTPS uniquement). Prod : true (obligatoire).
# En développement local (http://localhost) : false dans votre .env.
# Si la variable est absente : true en production, false ailleurs.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Domaines (hôte:port) dont les requêtes /api/auth et /api/admin reçoivent session + CSRF.
# Prod : le domaine du SPA, ex. registre.exemple.org (même origine que l'API).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# --- Limites de débit (voir config/rate-limits.php) ---------------------------
# Identifications par heure et par IP sur POST /api/public/identify, en plus des 5 jetons/heure
# par numéro et des 300 requêtes/min du groupe « public ».
# ATTENTION : tous les téléphones du Wi-Fi de l'Église sortent sur UNE adresse IP publique.
# La valeur doit absorber un dimanche chargé (bien plus de 100 identifications en une heure) ;
# ne la descendez pas sous 150 sans avoir mesuré l'affluence réelle.
RATE_LIMIT_IDENTIFY_PER_IP=200

# --- Proxies de confiance (voir config/trustedproxy.php) ----------------------
# Vide = aucun proxy : l'IP client est REMOTE_ADDR (cas d'Hostinger mutualisé sans CDN).
# Si le CDN Hostinger est activé : lister ses IP / plages CIDR, séparées par des virgules.
# « * » fait confiance à tout appelant (X-Forwarded-For falsifiable) : déconseillé.
TRUSTED_PROXIES=

# --- Files d'attente et cache -------------------------------------------------
# Pas de worker permanent : `queue:work --stop-when-empty` est lancé chaque minute par le planificateur.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- E-mails ------------------------------------------------------------------
# Dev : log (les e-mails sont écrits dans storage/logs). Prod : brevo (API HTTP Brevo).
MAIL_MAILER=log
# Clé API Brevo (Prod uniquement, transmise en en-tête HTTPS à l'API Brevo).
BREVO_API_KEY=
# Expéditeur : adresse d'un domaine à configurer, authentifié dans Brevo (enregistrements DNS
# SPF, DKIM et DMARC du domaine). Exemple : registre@votre-domaine.org.
# Obligatoire en production : sans elle, l'envoi échoue (aucune adresse par défaut).
MAIL_FROM_ADDRESS="registre@votre-domaine.org"
MAIL_FROM_NAME="Église La Maison de la Destinée"
